# Files and directories to exclude from the Docker build context.
# Keeping this lean makes Docker builds faster and smaller.

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Local database files (the Docker volume manages persistence)
data/
*.db
*.sqlite3

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation source (not needed in container)
docs/

# Environment variable files (never bake secrets into the image)
.env
.env.*

# Existing README (not needed inside container)
README.md
